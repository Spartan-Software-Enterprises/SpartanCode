{
  "expo": {
    "name": "SpartanCode",
    "slug": "spartancode",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.spartansoftware.spartancode",
      "resizeableActivity": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-speech-recognition",
      [
        "@pocketpalai/llama.rn",
        {
          "enableOpenCL": true,
          "forceCxx20": true
        }
      ],
      "./plugins/withInstallUpdates"
    ],
    "scheme": "spartancode"
  }
}

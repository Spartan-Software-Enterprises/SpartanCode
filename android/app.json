{
  "expo": {
    "name": "SpartanCode",
    "slug": "spartancode",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.spartansoftware.spartancode",
      "resizeableActivity": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b1020"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-speech-recognition"
    ],
    "scheme": "spartancode"
  }
}

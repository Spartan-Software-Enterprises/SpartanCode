{
  "name": "desktop-implementation",
  "version": "1.0.0",
  "description": "Agent-first local-first Vibe coding command center for desktop",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm run test && electron-builder --linux --dir && npm run release:manifest",
    "dist": "npm run test && electron-builder --linux",
    "test:visual": "node scripts/electron-visual-smoke.js",
    "test:browser": "node scripts/browser-live-smoke.js",
    "roadmap:audit": "node scripts/roadmap-audit.js",
    "skills:sync": "node scripts/sync-external-skills.js",
    "plugin:validate": "node scripts/plugin-validator.js",
    "plugin:publisher": "node scripts/marketplace-publisher.js",
    "check": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/desktop-api.js && node scripts/check-renderer-syntax.js",
    "release:manifest": "node scripts/release-manifest.js --output dist/release-evidence",
    "release:verify": "node scripts/verify-release-evidence.js",
    "desktop:evidence": "node scripts/desktop-baseline.js",
    "canonical:evidence": "node scripts/canonical-source-evidence.js",
    "android:evidence:verify": "node scripts/verify-android-evidence.js",
    "format:check": "prettier --check \"src/**/*.js\" \"src/**/*.html\"",
    "test": "npm run check && node --test src/main/*.test.js scripts/*.test.js && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spartan-Software-Enterprises/SpartanCode.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Spartan-Software-Enterprises/SpartanCode/issues"
  },
  "homepage": "https://github.com/Spartan-Software-Enterprises/SpartanCode#readme",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "com.spartansoftware.spartancode",
    "productName": "SpartanCode",
    "executableName": "SpartanCode",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}

{
  "name": "desktop-implementation",
  "version": "1.0.0",
  "description": "Agent-first local-first Vibe coding command center for desktop",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "npm run test && electron-builder --linux --dir && npm run release:manifest",
    "dist": "npm run test && electron-builder --linux",
    "check": "node --check src/main/main.js && node --check src/main/preload.js && node --check src/main/desktop-api.js",
    "release:manifest": "node scripts/release-manifest.js --output dist/release-evidence --scan dist/linux-arm64-unpacked",
    "format:check": "prettier --check \"src/**/*.js\" \"src/**/*.html\"",
    "test": "npm run check && node --test src/main/*.test.js scripts/release-manifest.test.js && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spartan-Software-Enterprises/SpartanCode.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Spartan-Software-Enterprises/SpartanCode/issues"
  },
  "homepage": "https://github.com/Spartan-Software-Enterprises/SpartanCode#readme",
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^43.4.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "com.spartansoftware.spartancode",
    "productName": "SpartanCode",
    "executableName": "SpartanCode",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*"
    ],
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "dir"
      ]
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
